rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if authenticated user is the designated Super Administrator
    function isSuperAdmin() {
      return request.auth != null && 
        ('email' in request.auth.token) &&
        request.auth.token.email.lower() == 'franklinkyleluzano@gmail.com';
    }

    // Public community bulletins & advisories
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Document clearance and certificate applications
    match /documents/{documentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Resident service reports and incident tickets
    match /services/{serviceId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Barangay officials roster and directory
    match /officials/{officialId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User account profiles & role assignments
    // - Allows reading the user directory for authorized portal functions
    // - Users can register and update their own profile
    // - Super Admin (franklinkyleluzano@gmail.com) can update any user's role (Official/Resident)
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }
  }
}
